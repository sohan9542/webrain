# Sanity CMS (public project settings used by the browser and SSR)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Optional: only needed if you enable authenticated Sanity requests
NEXT_PUBLIC_SANITY_TOKEN=

# Google Search Console verification meta content
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Canonical site URL used by next-sitemap
NEXT_PUBLIC_SITE_URL=
